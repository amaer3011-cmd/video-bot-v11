API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_IDS=

# مسار قاعدة البيانات (SQLite). لازم يكون جوه مجلد /data المربوط بـ Volume عشان البيانات ما تضيعش.
DB_PATH=/data/bot.db

# Access control: bot starts public; ALLOWED_USERS is used if private mode is selected in the admin panel.
# ADMIN_IDS=111
# ALLOWED_USERS=111,222

# --- يوتيوب: حل مشكلة "Sign in to confirm you're not a bot" ---
# الأسهل: ابعت ملف cookies.txt للبوت من لوحة الأدمن (🍪 كوكيز يوتيوب). أو حطه هنا كـ Base64:
#   Linux/Mac:  base64 -w0 cookies.txt     |  Windows PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# COOKIES_B64=
# بروكسي سكني (اختياري) لو الكوكيز لوحدها مش كفاية:  http://user:pass@host:port
# PROXY=
# عدد الخيوط للتحميلات المتزامنة (الافتراضي 128)
# THREADS=128

# High-speed profile is the default. Set to custom to honor lower values below.
TRANSFER_PROFILE=fast
UPLOAD_WORKERS=20
CONNECTIONS=28
FRAGMENTS=28

# --- النقل المباشر السريع (fastio.py) ---
# جلسات Media منفصلة للرفع المتوازي × طلبات متوازية لكل الرفع (UPLOAD_WORKERS). مناسب لـ 1GB RAM / 2 CPU.
UPLOAD_SESSIONS=6
# يوزر المطور على الزر (بدون @)
DEV_USERNAME=A7med19_7
# (اختياري) سيرفر تحميل خارجي متوافق مع cobalt: بيتجرب تلقائيًا لما يوتيوب/موقع يحجب IP السيرفر
# COBALT_API_URL=https://your-cobalt-instance.example.com
# COBALT_API_KEY=

# --- التقرير اليومي للأدمن ---
# الساعة (بتوقيت UTC) اللي يتبعت فيها التقرير اليومي. 6 = حوالي 8 صباحًا بتوقيت القاهرة. اكتب off للإيقاف.
DAILY_REPORT_HOUR=6

# --- المنطقة الزمنية للتحية (صباح/مساء الخير) ---
# اسم منطقة IANA. الافتراضي Africa/Cairo. لو الصورة مفيهاش tzdata بيستخدم UTC+2 تقريبيًا.
# BOT_TZ=Africa/Cairo

# (اختياري) vidkraken.com — خدمة مدفوعة لتحميل يوتيوب فقط، بتتجرب تلقائيًا لما يوتيوب يحجب السيرفر (قبل cobalt)
# VIDKRAKEN_API_KEY=

# --- v7 ---
# ضبط تلقائي لعدد الاتصالات/الخيوط لو رام الحاوية ≤ 1.1GB (الباقة المجانية). 0 للتعطيل.
# AUTO_TUNE=1
# تحديث yt-dlp تلقائيًا كل كام ساعة (0 = إيقاف). بيعيد التشغيل لما مفيش تحميلات شغّالة.
# ENGINE_UPDATE_HOURS=24
# كل كام دقيقة يفحص القنوات المراقبة (/watch). الحد الأدنى 5، و0 لإيقاف المراقبة.
# WATCH_INTERVAL_MIN=30

# --- v12: حدود التزامن (بتتظبط تلقائيًا حسب الرام؛ 0 = بلا سقف زي v11) ---
# تنزيلات على السيرفر / رفع وبث مباشر لتليجرام / عناصر شغّالة لنفس المستخدم / فحوصات روابط متزامنة.
# الزيادة عن الطاقة بتخلّي الزيادة تستنى في الطابور بدل ما تقع الحاوية (OOM) أو تتعمل FloodWait.
# MAX_DOWNLOADS=8
# MAX_UPLOADS=6
# MAX_PER_USER=4
# MAX_PROBES=12
# ثواني كاش نتيجة فحص الرابط (نفس الرابط خلال المدة دي = فوري). 0 للإيقاف.
# PROBE_TTL=600
# أقل مساحة فاضية (ميجا) قبل بدء تنزيل جديد
# MIN_FREE_MB=300
# عدد خيوط قراءة المصدر للبث المباشر (منفصلة عن خيوط yt-dlp)
# FASTIO_THREADS=48
